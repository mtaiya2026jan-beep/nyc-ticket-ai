# ============================================
# NYC Ticket AI — 环境变量配置
# 复制此文件为 .env.local 并填入真实值
# Vercel 部署时在 Project Settings > Environment Variables 中填入
# ============================================

# Supabase — 在 Supabase Dashboard > Settings > API 中找到
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic Claude API — 在 console.anthropic.com 中找到
ANTHROPIC_API_KEY=sk-ant-your-key-here
