                  \{p.featured && <div style=\{\{position:'absolute', top:-12, left:'50%', transform:'translateX(-50%)', background:'var(--accent)', color:'#000', fontSize:10, fontWeight:700, padding:'3px 12px', borderRadius:20, whiteSpace:'nowrap'\}\}>\uc0\u26368 \u21463 \u27426 \u36814 </div>\}\
