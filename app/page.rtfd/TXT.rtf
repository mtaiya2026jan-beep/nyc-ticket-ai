                \{name:'\uc0\u19987 \u19994 \u29256  Pro',price:'$99',per:'/\u26376 ',vs:'\u20256 \u32479  $1,500+/\u27425 ',featured:true,features:['\u26080 \u38480 \u27425 \u20998 \u26512 ','\u20840 \u26426 \u26500 \u35206 \u30422 ','220\u19975 \u26465 \u25968 \u25454 ','\u22810 \u36829 \u35268 \u24182 \u26512 ','PDF\u35782 \u21035 ','\u30003 \u35785 \u26448 \u26009 \u29983 \u25104 ']\},\
                \{name:'\uc0\u26426 \u26500 \u29256 ',price:'$299',per:'/\u26376 ',vs:'\u20256 \u32479 \u24459 \u25152  $3,000+',features:['Pro\u20840 \u21151 \u33021 ','\u22242 \u38431 \u31649 \u29702 ','API\u25509 \u20837 ','\u30333 \u26631 ','\u19987 \u23646 \u32463 \u29702 ']\},\
